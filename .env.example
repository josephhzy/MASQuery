# ────────────────────────────────────────────────────────────────────────
# LLM provider + key. Default: openai / gpt-4o-mini.
# Local:           copy this file to `.env` and paste your key below.
# Streamlit Cloud: paste these as key=value pairs in the app's Secrets panel
#                  (they auto-load as env vars).
# Railway/Render:  set them as project env vars in the dashboard.
# GitHub Actions:  set them as repo Secrets, then reference via ${{ secrets.OPENAI_API_KEY }}.
# ────────────────────────────────────────────────────────────────────────

# Required: key for the active provider
OPENAI_API_KEY=sk-xxxxx

# Optional: swap to anthropic by uncommenting and filling ANTHROPIC_API_KEY
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional overrides (safe defaults if unset)
LLM_PROVIDER=openai
# gpt-5-nano was anticipated but is not yet available; see platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini
SEARCH_MODE=vector
RERANK_ENABLED=true

# Dashboard -> API wiring.
# Local:           leave as http://localhost:8000
# Streamlit Cloud: set to your deployed backend URL (Railway/Render/Fly).
API_BASE_URL=http://localhost:8000

# HTTP surface hardening (optional).
# CORS_ALLOWED_ORIGINS: comma-separated origin list. Use "*" only for local/demo;
# set to concrete origins for any deployed instance.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
#
# INGEST_TOKEN: opt-in shared secret for POST /ingest. When set, requests must
# carry X-Ingest-Token: <value>. Leave unset for an open local /ingest.
# INGEST_TOKEN=replace-with-a-random-string
